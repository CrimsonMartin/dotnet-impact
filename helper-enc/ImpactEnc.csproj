<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <!-- The IVT identity; see ImpactHotReloadService.cs header. -->
    <AssemblyName>Microsoft.CodeAnalysis.ExternalAccess.HotReload</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>roslyn-public.snk</AssemblyOriginatorKeyFile>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.9.0" />
  </ItemGroup>

</Project>
